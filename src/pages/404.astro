---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
---
<Base titulo="Página não encontrada" descricao="O endereço acessado não existe no site da Dra. Thaís Santos." semIndice>
  <section class="envoltorio nao-encontrada">
    <Icone nome="faiscas-tres" class="nao-encontrada__faiscas" />
    <h1 class="display">Esta página não existe</h1>
    <p class="lead">O endereço pode ter mudado ou ter sido digitado de outro jeito. Estes caminhos levam ao que a maioria das pessoas procura:</p>
    <ul class="nao-encontrada__links">
      <li><a class="link" href="/">Página inicial</a></li>
      <li><a class="link" href="/primeira-consulta">Como funciona a primeira consulta</a></li>
      <li><a class="link" href="/artigos">Artigos</a></li>
      <li><a class="link" href="/agendar">Solicitar agendamento</a></li>
    </ul>
  </section>
</Base>

<style>
  .nao-encontrada {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 48rem;
    padding-block: var(--secao);
  }

  .nao-encontrada :global(.nao-encontrada__faiscas) {
    width: 6rem;
    color: var(--caramelo);
  }

  .nao-encontrada__links {
    display: grid;
    gap: 0.75rem;
  }
</style>
