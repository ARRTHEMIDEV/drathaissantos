---
// Símbolos usados na identidade da Dra. Thaís (extraídos de _marca-arthemi/Marca.ai),
// inline e com currentColor. O monograma "A" e o logotipo ARTHEMI são da marca do
// Espaço Arthemi (coworking) e não entram neste site.
const svgs = import.meta.glob<string>('../assets/marca/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  nome: 'faisca' | 'faiscas-cinco' | 'faiscas-tres' | 'brilho' | 'leque' | 'nome-horizontal' | 'nome-empilhado';
  class?: string;
  rotulo?: string;
}
const { nome, class: classe, rotulo } = Astro.props;
let svg = svgs[`../assets/marca/${nome}.svg`] ?? '';
if (rotulo) {
  svg = svg.replace('aria-hidden="true"', `role="img" aria-label="${rotulo}"`);
}
---
<span class:list={['icone', classe]} set:html={svg} />
<style>
  .icone {
    display: inline-block;
    line-height: 0;
  }
  .icone :global(svg) {
    width: 100%;
    height: auto;
  }
</style>
