---
// A primeira consulta em rolagem horizontal: no desktop a seção fica fixa e os
// capítulos correm para o lado conforme a rolagem; no celular o título fica
// acima e só os cartões deslizam, com as faíscas marcando a etapa. A ordem de
// leitura do HTML é a mesma da história.
import Foto from '../Foto.astro';
import Icone from '../Icone.astro';
import Seta from '../Seta.astro';
import Pendente from '../Pendente.astro';
import { etapasConsulta } from '../../data/consulta';
---
<section class="horizontal sobre-papel-claro" aria-labelledby="titulo-horizontal" data-horizontal>
  <!-- Cabeça só do celular: o título não desliza junto com os cartões. -->
  <div class="envoltorio horizontal__cabeca">
    <h2 class="display horizontal__titulo" data-revelar="linhas">A primeira consulta</h2>
    <p class="lead">Um encontro para entender a dor antes de decidir qualquer tratamento.</p>
    <p class="auxiliar"><Pendente motivo="sequência a confirmar com a rotina real" /></p>
    <div class="horizontal__guia" aria-hidden="true">
      <span class="horizontal__progresso">
        {etapasConsulta.map(() => (
          <span class="horizontal__passo" data-horizontal-passo-celular><Icone nome="faisca" /></span>
        ))}
      </span>
      <span class="auxiliar">Deslize para o lado</span>
    </div>
  </div>

  <div class="horizontal__trilho" data-horizontal-trilho>
    <div class="horizontal__intro">
      <h2 class="display horizontal__titulo" id="titulo-horizontal">A primeira consulta</h2>
      <p class="lead">Um encontro para entender a dor antes de decidir qualquer tratamento.</p>
      <p class="auxiliar"><Pendente motivo="sequência a confirmar com a rotina real" /></p>
      <div class="horizontal__progresso" aria-hidden="true">
        {etapasConsulta.map(() => (
          <span class="horizontal__passo" data-horizontal-passo><Icone nome="faisca" /></span>
        ))}
      </div>
      <p class="horizontal__dica auxiliar" aria-hidden="true">Role para avançar</p>
    </div>

    {etapasConsulta.map((etapa, i) => (
      <article class="horizontal__cartao" aria-labelledby={`horizontal-${etapa.id}`} data-horizontal-cartao={i}>
        <div class="horizontal__foto">
          <Foto foto={etapa.foto} proporcao="4 / 5" sizes="(min-width: 64rem) 30vw, 80vw" />
        </div>
        <span class="horizontal__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="horizontal__nome" id={`horizontal-${etapa.id}`}>{etapa.titulo}</h3>
        <p class="auxiliar">{etapa.resumo}</p>
      </article>
    ))}

    <div class="horizontal__fim">
      <a class="horizontal__circulo" href="/primeira-consulta" data-magnetico="0.4">
        <span>Ver todas as etapas</span>
        <Seta />
      </a>
    </div>
  </div>
</section>

<script>
  // Celular: a faísca da etapa acende quando o cartão dela ocupa o trilho.
  const trilho = document.querySelector<HTMLElement>('[data-horizontal-trilho]');
  const passos = [...document.querySelectorAll<HTMLElement>('[data-horizontal-passo-celular]')];
  const cartoes = [...document.querySelectorAll<HTMLElement>('[data-horizontal-cartao]')];
  if (trilho && passos.length && window.matchMedia('(max-width: 47.99rem)').matches) {
    const acender = (ativo: number) => passos.forEach((p, i) => p.classList.toggle('aceso', i <= ativo));
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) acender(Number((e.target as HTMLElement).dataset.horizontalCartao));
        });
      },
      { root: trilho, threshold: 0.6 },
    );
    cartoes.forEach((c) => observador.observe(c));
  }
</script>

<style>
  .horizontal {
    position: relative;
    background: var(--papel-claro);
    overflow: hidden;
  }

  .horizontal__trilho {
    display: flex;
    gap: 1.25rem;
    padding: var(--secao) var(--margem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margem);
    scrollbar-width: none;
  }

  .horizontal__trilho::-webkit-scrollbar {
    display: none;
  }

  .horizontal__intro {
    flex: 0 0 84vw;
    display: grid;
    gap: 1.25rem;
    align-content: center;
    scroll-snap-align: start;
  }

  .horizontal__titulo {
    font-size: var(--t-secao);
  }

  .horizontal__cabeca {
    display: none;
  }

  .horizontal__progresso {
    display: flex;
    gap: 0.6rem;
  }

  .horizontal__passo {
    display: grid;
    width: 1.1rem;
    color: var(--linha-forte);
    transition: color 0.4s, scale 0.5s var(--curva-entrada), rotate 0.5s var(--curva-entrada);
  }

  .horizontal__passo:global(.aceso) {
    color: var(--caramelo);
    scale: 1.3;
    rotate: 90deg;
  }

  .horizontal__dica {
    display: none;
  }

  .horizontal__cartao {
    position: relative;
    flex: 0 0 78vw;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    scroll-snap-align: start;
  }

  .horizontal__foto {
    overflow: hidden;
    border-radius: var(--raio);
    margin-bottom: 0.6rem;
  }

  .horizontal__foto :global(img) {
    transition: scale 1.2s var(--curva-entrada);
  }

  .horizontal__cartao:hover .horizontal__foto :global(img) {
    scale: 1.06;
  }

  .horizontal__numero {
    position: absolute;
    top: -0.35em;
    right: 0.1em;
    font-family: var(--fonte-display);
    font-size: clamp(5rem, 3rem + 8vw, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--caramelo);
    pointer-events: none;
  }

  .horizontal__nome {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.5rem);
    font-weight: 560;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--verde);
  }

  .horizontal__fim {
    flex: 0 0 60vw;
    display: grid;
    place-items: center;
    scroll-snap-align: center;
  }

  .horizontal__circulo {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    width: clamp(10rem, 8rem + 8vw, 16rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--verde);
    color: var(--sobre-verde);
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    padding: 1.5rem;
    transition: background-color 0.4s var(--curva-entrada);
  }

  .horizontal__circulo:hover {
    background: var(--caramelo);
  }

  .horizontal__circulo :global(.seta) {
    width: 1.5rem;
  }

  @media (max-width: 47.99rem) {
    .horizontal {
      padding-top: var(--secao);
    }

    .horizontal__cabeca {
      display: grid;
      gap: 0.75rem;
    }

    .horizontal__intro {
      display: none;
    }

    .horizontal__guia {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .horizontal__trilho {
      gap: 1rem;
      padding: 1.75rem var(--margem) var(--secao);
    }

    .horizontal__cartao {
      flex: 0 0 min(72vw, 18rem);
      gap: 0.4rem;
    }

    .horizontal__foto :global(.foto) {
      aspect-ratio: 1;
    }

    .horizontal__numero {
      top: -0.32em;
      font-size: 4rem;
      -webkit-text-stroke-width: 1.25px;
    }

    .horizontal__nome {
      font-size: var(--t-item);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .horizontal__fim {
      flex: 0 0 min(56vw, 14rem);
    }

    .horizontal__circulo {
      width: 9rem;
      gap: 0.5rem;
      padding: 1.25rem;
      font-size: var(--t-pequeno);
    }

    .horizontal__circulo :global(.seta) {
      width: 1.2rem;
    }
  }

  @media (min-width: 64rem) {
    .horizontal__trilho {
      width: max-content;
      height: 100svh;
      align-items: center;
      gap: clamp(3rem, 5vw, 6rem);
      padding: 0 8vw 0 calc((100vw - min(100vw, var(--largura-max) + var(--margem) * 2)) / 2 + var(--margem));
      overflow: visible;
      scroll-snap-type: none;
    }

    .horizontal__intro {
      flex-basis: 30rem;
    }

    .horizontal__dica {
      display: block;
    }

    .horizontal__cartao {
      flex-basis: auto;
      width: min(24rem, 26vw);
      padding-top: clamp(3.5rem, 7svh, 5.5rem);
    }

    .horizontal__cartao:nth-of-type(even) {
      margin-top: 14svh;
    }

    .horizontal__foto :global(.foto) {
      height: min(48svh, 30rem);
      aspect-ratio: auto;
    }

    .horizontal__numero {
      top: 0;
      font-size: clamp(5rem, 3rem + 5vw, 8.5rem);
    }

    .horizontal__fim {
      flex-basis: 30vw;
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 64rem) {
    /* Sem a fixação da seção, o trilho rola na horizontal normalmente. */
    .horizontal__trilho {
      width: auto;
      overflow-x: auto;
    }
  }
</style>
