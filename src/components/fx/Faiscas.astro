---
// Faíscas de moxabustão: brasas finas que sobem devagar e algumas estrelas de
// quatro pontas que cintilam (o símbolo da marca). Canvas leve, pausa fora da
// tela e com a aba oculta; não roda com "reduzir movimento".
interface Props {
  tom?: 'caramelo' | 'claro';
  densidade?: number;
  class?: string;
}
const { tom = 'caramelo', densidade = 1, class: classe } = Astro.props;
---
<canvas class:list={['faiscas', classe]} data-faiscas={tom} data-densidade={densidade} aria-hidden="true"></canvas>

<script>
  type Particula = { x: number; y: number; vy: number; vx: number; r: number; vida: number; max: number; fase: number; estrela: boolean };

  const paletas: Record<string, string[]> = {
    caramelo: ['174,125,84', '196,150,104', '138,92,55'],
    claro: ['243,238,229', '218,190,150', '174,125,84'],
  };

  function estrela(ctx: CanvasRenderingContext2D, x: number, y: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x, y - r);
    ctx.quadraticCurveTo(x + r * 0.12, y - r * 0.12, x + r, y);
    ctx.quadraticCurveTo(x + r * 0.12, y + r * 0.12, x, y + r);
    ctx.quadraticCurveTo(x - r * 0.12, y + r * 0.12, x - r, y);
    ctx.quadraticCurveTo(x - r * 0.12, y - r * 0.12, x, y - r);
    ctx.fill();
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-faiscas]').forEach((canvas) => {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const cores = paletas[canvas.dataset.faiscas ?? 'caramelo'];
      const densidade = Number(canvas.dataset.densidade ?? 1);
      let w = 0, h = 0, dpr = 1, visivel = false, rodando = false;
      let particulas: Particula[] = [];
      const ponteiro = { x: -999, y: -999 };

      const nova = (inicio = false): Particula => ({
        x: Math.random() * w,
        y: inicio ? Math.random() * h : h + 10,
        vy: -(0.12 + Math.random() * 0.45),
        vx: (Math.random() - 0.5) * 0.15,
        r: Math.random() < 0.2 ? 3.5 + Math.random() * 5 : 0.8 + Math.random() * 1.8,
        vida: 0,
        max: 380 + Math.random() * 520,
        fase: Math.random() * Math.PI * 2,
        estrela: false,
      });

      const medir = () => {
        const r = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const total = Math.round(Math.min(120, (w * h) / 16000) * densidade);
        particulas = Array.from({ length: total }, () => {
          const p = nova(true);
          p.estrela = p.r > 3;
          p.vida = Math.random() * p.max;
          return p;
        });
      };

      const quadro = () => {
        if (!visivel || document.hidden) { rodando = false; return; }
        rodando = true;
        ctx.clearRect(0, 0, w, h);
        for (const p of particulas) {
          p.vida++;
          p.fase += 0.02;
          const dx = p.x - ponteiro.x, dy = p.y - ponteiro.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 14000) { p.x += dx * 0.004; p.y += dy * 0.004; }
          p.x += p.vx + Math.sin(p.fase) * 0.18;
          p.y += p.vy;
          const t = p.vida / p.max;
          const alfa = Math.sin(Math.min(1, t) * Math.PI) * (p.estrela ? 0.95 : 0.7);
          if (t >= 1 || p.y < -12) { Object.assign(p, nova()); p.estrela = p.r > 3; continue; }
          const cor = cores[Math.floor(p.fase * 10) % cores.length] ?? cores[0];
          ctx.fillStyle = `rgba(${cor},${Math.max(0, alfa)})`;
          if (p.estrela) {
            const brilho = 0.75 + Math.sin(p.fase * 3) * 0.25;
            estrela(ctx, p.x, p.y, p.r * brilho);
          } else {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        requestAnimationFrame(quadro);
      };

      const iniciar = () => { if (!rodando && visivel) requestAnimationFrame(quadro); };
      new ResizeObserver(medir).observe(canvas);
      new IntersectionObserver(([e]) => { visivel = e.isIntersecting; iniciar(); }).observe(canvas);
      document.addEventListener('visibilitychange', iniciar);
      canvas.parentElement?.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        ponteiro.x = e.clientX - r.left; ponteiro.y = e.clientY - r.top;
      });
      canvas.parentElement?.addEventListener('pointerleave', () => { ponteiro.x = -999; ponteiro.y = -999; });
      medir();
    });
  }
</script>

<style>
  .faiscas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
